---
auth_enabled: false

server:
  http_listen_port: 8099

common:
  instance_addr: 127.0.0.1
  path_prefix: /opt/loki/storage
  storage:
    filesystem:
      chunks_directory: /opt/loki/storage/chunks
      rules_directory: /opt/loki/storage/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

schema_config:
  configs:
    - from: 2023-07-06
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

compactor:
  working_directory: /opt/loki/storage/retention
  compaction_interval: 59m
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 50
  delete_request_store: filesystem

limits_config:
  retention_period: 744h

analytics:
  reporting_enabled: false
